[Manifest]
Type=filename
Label=Job Manifest (hpm.toml)
Category=HPM Options
CategoryOrder=0
Index=0
Description=The bundled hpm.toml the worker installs and runs the task from. Its dependencies hold the task package at an exact version and its [scripts.task] runs the task module inside the package-env. Required.
Required=false
DisableIfBlank=false
Default=

[Package]
Type=string
Label=Package
Category=HPM Options
CategoryOrder=0
Index=1
Description=Informational: the task package identity (name@version), kept for job introspection. The packages to install come from the Manifest.
Required=false
DisableIfBlank=true
Default=

[ScriptFile]
Type=string
Label=Script File
Category=HPM Options
CategoryOrder=0
Index=2
Description=Informational: the package-relative task script. The task to run comes from the Manifest's [scripts.task].
Required=false
DisableIfBlank=true
Default=

[HpmVersion]
Type=string
Label=HPM Version
Category=HPM Options
CategoryOrder=0
Index=3
Description=hpm CLI version to self-bootstrap on a cache miss: a pinned tag like v0.36.1 (recommended) or 'latest'. Must be >= v0.22.2 — the task runs through hpm's package-env script mode (hpm run task). Defaults to the HPM_VERSION env var on the worker, else the version this plugin release pins (v0.36.1). Avoid 'latest' — an unvetted hpm release can break installs.
Required=false
DisableIfBlank=true
Default=

[HpmExecutable]
Type=string
Label=HPM Executable (override)
Category=HPM Options
CategoryOrder=0
Index=4
Description=Explicit hpm executable to use instead of the self-bootstrapped one (PATH name or absolute path), e.g. on air-gapped workers. Leave blank to let the plugin manage hpm under ~/.deadline/hpm.
Required=false
DisableIfBlank=true
Default=

[HpmManagedDirectory]
Type=folder
Label=HPM Managed Directory
Category=HPM Options
CategoryOrder=0
Index=5
Description=Where the plugin stores the self-bootstrapped hpm binary (defaults to ~/.deadline/hpm).
Required=false
DisableIfBlank=true
Default=

[StartupDirectory]
Type=folder
Label=Job Data Directory
Category=Task Options
CategoryOrder=1
Index=0
Description=The job's shared data directory, readable by every worker. Exported to the task as TH_FARM_DATA; a relative first argument is resolved against it. Required.
Required=true
DisableIfBlank=false
Default=

[Arguments]
Type=string
Label=Arguments
Category=Task Options
CategoryOrder=1
Index=1
Description=The task's arguments, split on whitespace (usually the context path, relative to the data directory). The task's first and last frame are appended.
Required=false
DisableIfBlank=true

[EnvironmentFile]
Type=filename
Label=Environment File
Category=Task Options
CategoryOrder=1
Index=2
Description=A .env file whose KEY=VALUE lines are set in the task's environment. Read as UTF-8, else the worker locale's encoding.
Required=false
DisableIfBlank=false
Default=

[SingleFramesOnly]
Type=boolean
Label=Single Frames Only
Category=Task Options
CategoryOrder=1
Index=3
Description=If enabled, the plugin will only render one frame at a time even if a single task contains a chunk of frames.
Required=false
DisableIfBlank=false
Default=true
